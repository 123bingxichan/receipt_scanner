# Database
DATABASE_URL="postgresql://user:password@localhost:5432/receipt_scan"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth
AUTH_SECRET=""

# OCR provider keys. Fill only the provider you use.
# Copy this file to .env.local and set real values there (never commit .env.local).
OCR_SPACE_API_KEY=""
OPENAI_API_KEY=""
# "mock" (dev, fixed sample text) or "ocr_space" (needs OCR_SPACE_API_KEY)
OCR_PROVIDER="mock"

# Object storage
STORAGE_PROVIDER="local"
# Optional: where local uploads go (default ./.uploads)
LOCAL_STORAGE_DIR=""
# Until auth exists, all requests act as this single user
DEFAULT_USER_EMAIL="local@receipt-scan.dev"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
